# Copy to .env and edit as needed. The defaults below are also baked into
# docker-compose.yml via ${VAR:-default} — .env just lets you override.

DB_ROOT_PASSWORD=dvwa_root
DB_NAME=dvwa
DB_USER=dvwa
DB_PASSWORD=p@ssw0rd

# DVWA default security level on container start. Orchestrator (phase 5)
# flips this per session via POST /security.php; this is just the boot value.
DVWA_SECURITY_LEVEL=low

# ── phase-bench-1: real LLM browser agent ─────────────────────────────
# The `real_agent` service is the ONLY component in this lab with
# cloud egress. It is gated under `profiles: ["real-agent"]` so it
# does not start under the default `docker compose up`. To run it:
#     docker compose --profile real-agent up --build
#
# Provide one of the keys below depending on CERNIS_AGENT_BACKEND. .env
# is gitignored — do NOT commit your key. The smoke test verifies that
# no `sk-*` / `sk-ant-*` substring leaks into the repo or data/.

# CERNIS_AGENT_BACKEND=openai            # openai | anthropic
# CERNIS_AGENT_MODEL=gpt-4o-mini         # backend-specific default if unset
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CERNIS_AGENT_TASK=                     # override the default task prompt
# CERNIS_SESSIONS_REAL_AGENT=1
