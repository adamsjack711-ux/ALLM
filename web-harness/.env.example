# Copy to .env and edit as needed. The defaults below are also baked into
# docker-compose.yml via ${VAR:-default} — .env just lets you override.

DB_ROOT_PASSWORD=dvwa_root
DB_NAME=dvwa
DB_USER=dvwa
DB_PASSWORD=p@ssw0rd

# DVWA default security level on container start. Orchestrator (phase 5)
# flips this per session via POST /security.php; this is just the boot value.
DVWA_SECURITY_LEVEL=low
