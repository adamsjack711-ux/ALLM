.env
data/*
!data/.gitkeep
!data/reports
data/reports/*
!data/reports/.gitkeep
data/models/

# phase-bench-2: hidden test splits stay local. Public splits in the
# same dirs ARE committed.
benchmark/splits/*/private_*.json

# phase-bench-3: release artifacts (built by `benchmark.release.build_release`)
# live under dist/. Never committed — the public release ships via tar.gz
# attached to a git tag instead.
dist/

__pycache__/
*.pyc
*.pyo
.venv/
node_modules/

.DS_Store
